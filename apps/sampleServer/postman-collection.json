{
  "info": {
    "name": "Omega Flow Sample Server",
    "description": "API collection for Omega Flow Sample Server - Workflow and Context management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5010",
      "type": "string"
    },
    {
      "key": "domain",
      "value": "default",
      "type": "string"
    },
    {
      "key": "workflowId",
      "value": "",
      "type": "string"
    },
    {
      "key": "subjectId",
      "value": "user-123",
      "type": "string"
    },
    {
      "key": "instanceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Workflows",
      "item": [
        {
          "name": "List Workflows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{domain}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{domain}}"]
            },
            "description": "Get all workflows in a domain"
          }
        },
        {
          "name": "Get Workflow",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{domain}}/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{domain}}", "{{workflowId}}"]
            },
            "description": "Get a specific workflow by ID"
          }
        },
        {
          "name": "Create Workflow",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('workflowId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Workflow\",\n  \"flow\": {\n    \"nodes\": [\n      {\n        \"id\": \"trigger-1\",\n        \"type\": \"trigger\",\n        \"position\": { \"x\": 100, \"y\": 100 },\n        \"data\": { \"eventType\": \"user.signup\" }\n      },\n      {\n        \"id\": \"action-1\",\n        \"type\": \"action\",\n        \"position\": { \"x\": 100, \"y\": 200 },\n        \"data\": { \"actionType\": \"sendEmail\" }\n      },\n      {\n        \"id\": \"exit-1\",\n        \"type\": \"exit\",\n        \"position\": { \"x\": 100, \"y\": 300 },\n        \"data\": {}\n      }\n    ],\n    \"edges\": [\n      {\n        \"id\": \"e1\",\n        \"source\": \"trigger-1\",\n        \"target\": \"action-1\"\n      },\n      {\n        \"id\": \"e2\",\n        \"source\": \"action-1\",\n        \"target\": \"exit-1\"\n      }\n    ]\n  },\n  \"options\": {\n    \"frequency\": {\n      \"type\": \"one_time\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{domain}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{domain}}"]
            },
            "description": "Create a new workflow. The ID is auto-generated."
          }
        },
        {
          "name": "Update Workflow",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Workflow\",\n  \"flow\": {\n    \"nodes\": [\n      {\n        \"id\": \"trigger-1\",\n        \"type\": \"trigger\",\n        \"position\": { \"x\": 100, \"y\": 100 },\n        \"data\": { \"eventType\": \"user.signup\" }\n      },\n      {\n        \"id\": \"action-1\",\n        \"type\": \"action\",\n        \"position\": { \"x\": 100, \"y\": 200 },\n        \"data\": { \"actionType\": \"sendEmail\" }\n      },\n      {\n        \"id\": \"exit-1\",\n        \"type\": \"exit\",\n        \"position\": { \"x\": 100, \"y\": 300 },\n        \"data\": {}\n      }\n    ],\n    \"edges\": [\n      {\n        \"id\": \"e1\",\n        \"source\": \"trigger-1\",\n        \"target\": \"action-1\"\n      },\n      {\n        \"id\": \"e2\",\n        \"source\": \"action-1\",\n        \"target\": \"exit-1\"\n      }\n    ]\n  },\n  \"options\": {\n    \"frequency\": {\n      \"type\": \"every_rematch\",\n      \"interval\": 3600\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{domain}}/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{domain}}", "{{workflowId}}"]
            },
            "description": "Update an existing workflow"
          }
        },
        {
          "name": "Delete Workflow",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{domain}}/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{domain}}", "{{workflowId}}"]
            },
            "description": "Delete a workflow"
          }
        }
      ]
    },
    {
      "name": "Contexts",
      "item": [
        {
          "name": "List Contexts for Subject",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contexts/{{domain}}/{{subjectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contexts", "{{domain}}", "{{subjectId}}"]
            },
            "description": "Get all contexts for a subject in a domain"
          }
        },
        {
          "name": "List Contexts for Subject+Workflow",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contexts/{{domain}}/{{subjectId}}/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contexts", "{{domain}}", "{{subjectId}}", "{{workflowId}}"]
            },
            "description": "Get all contexts for a specific subject and workflow"
          }
        },
        {
          "name": "Get Context",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contexts/{{domain}}/{{subjectId}}/{{workflowId}}/{{instanceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contexts", "{{domain}}", "{{subjectId}}", "{{workflowId}}", "{{instanceId}}"]
            },
            "description": "Get a specific context by instance ID"
          }
        },
        {
          "name": "Save Context",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('instanceId', jsonData.instanceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflowId\": \"{{workflowId}}\",\n  \"instanceId\": \"inst-{{$timestamp}}\",\n  \"currentNodeId\": \"trigger-1\",\n  \"nodeState\": {},\n  \"history\": [\n    {\n      \"time\": {{$timestamp}},\n      \"type\": \"started\",\n      \"fromNodeId\": null,\n      \"toNodeId\": \"trigger-1\"\n    }\n  ],\n  \"isCompleted\": false,\n  \"startedAt\": {{$timestamp}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contexts/{{domain}}/{{subjectId}}/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contexts", "{{domain}}", "{{subjectId}}", "{{workflowId}}"]
            },
            "description": "Create or update a context"
          }
        },
        {
          "name": "Delete Context",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contexts/{{domain}}/{{subjectId}}/{{workflowId}}/{{instanceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contexts", "{{domain}}", "{{subjectId}}", "{{workflowId}}", "{{instanceId}}"]
            },
            "description": "Delete a context"
          }
        }
      ]
    }
  ]
}
