{
  "name": "@omega-flow/editor",
  "version": "0.2.0",
  "description": "Workflow editor components for Omega Flow",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/dark.css": "./dist/themes/dark.css"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-flow/omega-flow.git",
    "directory": "packages/editor"
  },
  "homepage": "https://omega-flow.github.io/omega-flow/",
  "bugs": "https://github.com/omega-flow/omega-flow/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && pnpm build:css",
    "build:css": "mkdir -p dist/themes && cp src/styles/variables.css dist/styles.css && cp src/styles/themes/*.css dist/themes/",
    "dev": "tsdown --watch",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@omega-flow/types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2"
  }
}
