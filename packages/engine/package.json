{
  "name": "@omega-flow/engine",
  "version": "0.2.0",
  "description": "Workflow engine for Omega Flow",
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-flow/omega-flow.git",
    "directory": "packages/engine"
  },
  "homepage": "https://omega-flow.github.io/omega-flow/",
  "bugs": "https://github.com/omega-flow/omega-flow/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "dev": "tsdown src/index.ts --format cjs,esm --dts --watch",
    "test": "jest --verbose --passWithNoTests",
    "test:watch": "jest --watchAll --verbose --passWithNoTests --detectOpenHandles",
    "test:coverage": "jest --verbose --coverage"
  },
  "devDependencies": {},
  "dependencies": {
    "@omega-flow/types": "workspace:*",
    "ajv": "^8.20.0"
  }
}
