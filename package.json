{
  "name": "omega-flow",
  "packageManager": "pnpm@10.15.0",
  "version": "0.0.0",
  "description": "Omega Flow is a workflow builder and engine for automating tasks and processes.",
  "keywords": [
    "workflow",
    "builder",
    "engine",
    "automation"
  ],
  "author": "fones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omega-flow/omega-flow.git"
  },
  "homepage": "https://omega-flow.github.io/omega-flow/",
  "bugs": "https://github.com/omega-flow/omega-flow/issues",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm --filter=@omega-flow/* run build",
    "test": "pnpm --filter=@omega-flow/* run test",
    "test:coverage": "pnpm --filter=@omega-flow/* run test:coverage",
    "lint": "pnpm --filter=@omega-flow/* run lint",
    "clean": "rimraf 'packages/*/{dist,node_modules}' && rimraf node_modules",
    "dev:app": "pnpm --filter=@omega-flow/sample-app run dev",
    "dev:server": "pnpm --filter=@omega-flow/sample-server run dev",
    "dev:server:dynamodb": "pnpm --filter=@omega-flow/sample-server run dev:dynamodb",
    "dev:doc": "pnpm --filter=@omega-flow/doc run dev",
    "dev:packages": "pnpm --filter=@omega-flow/types --filter=@omega-flow/engine --filter=@omega-flow/editor --parallel run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm changeset publish",
    "outdated": "pnpm outdated -r",
    "update:check": "pnpm outdated -r",
    "update:interactive": "pnpm update -r -i",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.8",
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "only-allow": "^1.2.2",
    "publint": "^0.3.21",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
