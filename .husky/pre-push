while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  BAD_COMMITS=$(git log --format="%H %ai" "$range" | grep -v " 20:00:00 ")
  if [ -n "$BAD_COMMITS" ]; then
    echo "ERROR: The following commits do not have 20:00 timestamps:"
    echo "$BAD_COMMITS"
    echo "Run the post-commit hook or amend the commits before pushing."
    exit 1
  fi
done
